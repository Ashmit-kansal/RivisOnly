# RivisOnly - Firebase Configuration
# Get these credentials for FREE from https://console.firebase.google.com/
# 1. Create a free project (Spark Plan - $0)
# 2. Click Project Settings -> Your apps -> Web (</>)
# 3. Copy the values below:

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Gemini API Key (works as GEMINI_API_KEY or VITE_GEMINI_API_KEY)
# From https://aistudio.google.com/app/apikey
# If omitted, users can plug in their own free key via the in-app AI Quota Settings
GEMINI_API_KEY=your_gemini_api_key_here


